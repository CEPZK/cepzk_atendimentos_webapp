# ─── Supabase (project lives in cepzk_atendimentos_backend) ───────────────
# Dashboard → Project Settings → API keys. Publishable keys are the current
# format; NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted for legacy projects only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Invite-only tool: keep false until admins provision users. When false the
# login form sends no email to unknown addresses.
NEXT_PUBLIC_ALLOW_SELF_SIGNUP=false

# ─── Server-only ────────────────────────────────────────────────────────────
# OPTIONAL: only needed if the backend ever pushes webhooks to this app.
# Generate with: openssl rand -hex 32
# INTERNAL_WEBHOOK_SECRET=

# ─── Deliberately NOT here ─────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY / DATABASE_URL / DIRECT_URL must live in Supabase
# Edge Function secrets. If they are present here, src/lib/env/server.ts throws
# at boot by design. See contracts/env-matrix.md.
