# =============================================================================
# Credenciais do Supabase — copie para .env.local e preencha.
# Onde encontrar: Dashboard do Supabase → Project Settings → API
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# =============================================================================
# Opcional — botão "Grupo de WhatsApp" na tela inicial
# =============================================================================
# Link de convite do grupo (https://chat.whatsapp.com/...). Quem clica no
# botão pode entrar no grupo mesmo sem ser membro, desde que o convite por
# link esteja ativo no grupo.
#
# Como obter: WhatsApp → abra o grupo → Informações do grupo →
# "Convidar por link" → Copiar link.
#
# Sem o valor (ou com valor inválido), o botão simplesmente não é exibido.
# NEXT_PUBLIC_WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/SEU_CODIGO

# Observação: a service role key NUNCA deve ser usada no frontend.
