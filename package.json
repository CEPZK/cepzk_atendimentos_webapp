{
  "name": "cepzk_atendimentos_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,mjs}\"",
    "check": "npm run lint && npm run typecheck && npm run sql:lint && npm run build",
    "types:generate": "node scripts/generate-types.mjs",
    "contract:hash": "node scripts/contract-hash.mjs",
    "contract:check": "node scripts/generate-types.mjs --check",
    "sql:lint": "node scripts/lint-sql.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@tanstack/react-query": "^5.102.8",
    "geist": "^1.7.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pgsql-parser": "^18.2.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.11"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
